# ========================================
# 生产环境配置文件
# ========================================
# 说明：本项目不使用数据库，所有数据来源于外部 API
# 部署到 Vercel 时，在 Vercel Dashboard -> Settings -> Environment Variables 中配置

# ========================================
# 数据库配置（仅用于本地文件存储）
# ========================================
# 使用 SQLite 存储本地缓存和配置数据
# Vercel 部署时会自动使用临时文件系统
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./prod.db

# ========================================
# SHEIN 正式环境配置
# ========================================

# SHEIN 应用配置（从 SHEIN 开发者门户获取正式环境凭证）
# 步骤：登录开发者门户 -> 应用管理 -> 切换到正式环境 -> 查看应用详情
SHEIN_APP_ID=your_production_app_id_here
SHEIN_APP_SECRET_KEY=your_production_app_secret_key_here

# SHEIN API 调用域名（正式环境）
SHEIN_API_BASE_URL=https://openapi.sheincorp.com

# SHEIN 店铺授权密钥（通过授权流程获取后填入）
# 访问 https://admin-panel-4ylw.vercel.app/admin/shein-auth 进行授权
SHEIN_OPEN_KEY_ID=your_production_open_key_id
SHEIN_SECRET_KEY=your_production_secret_key

# ========================================
# 应用配置
# ========================================

# 应用域名（用于回调 URL 等）
NEXT_PUBLIC_APP_URL=https://admin-panel-4ylw.vercel.app

# Node 环境
NODE_ENV=production

# ========================================
# 安全配置（可选但推荐）
# ========================================

# NextAuth 密钥（用于会话加密，使用 openssl rand -base64 32 生成）
# NEXTAUTH_SECRET=your_nextauth_secret_here
# NEXTAUTH_URL=https://admin-panel-4ylw.vercel.app

# API 密钥（如果有自定义 API 需要保护）
# API_SECRET_KEY=your_api_secret_key_here

# ========================================
# 日志和监控（可选）
# ========================================

# Sentry DSN（错误追踪）
# SENTRY_DSN=your_sentry_dsn_here

# 日志级别
# LOG_LEVEL=info

# ========================================
# 支付配置（如果已集成）
# ========================================

# PayPal
# PAYPAL_CLIENT_ID=your_paypal_client_id
# PAYPAL_CLIENT_SECRET=your_paypal_client_secret
# PAYPAL_MODE=live

# Stripe
# STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
# STRIPE_SECRET_KEY=your_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# ========================================
# 邮件服务（可选）
# ========================================

# SMTP 配置
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=noreply@admin-panel-4ylw.vercel.app

# ========================================
# Redis/缓存配置（可选）
# ========================================

# Redis URL（用于缓存、会话存储等）
# REDIS_URL=redis://username:password@host:port

# ========================================
# AI SDK 配置（如果使用）
# ========================================

# OpenAI
# OPENAI_API_KEY=your_openai_api_key

# Anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key

# ========================================
# 部署配置提示
# ========================================
#
# Vercel 部署步骤：
# 1. 在 Vercel Dashboard 中选择项目
# 2. Settings -> Environment Variables
# 3. 添加以下必需的环境变量
# 4. 确保 Environment 选择 "Production"
# 5. 保存后触发重新部署
#
# 必需的环境变量（最小配置）：
# - SHEIN_APP_ID
# - SHEIN_APP_SECRET_KEY
# - SHEIN_API_BASE_URL=https://openapi.sheincorp.com
# - SHEIN_OPEN_KEY_ID（授权后填入）
# - SHEIN_SECRET_KEY（授权后填入）
# - NEXT_PUBLIC_APP_URL=https://admin-panel-4ylw.vercel.app
#
# 获取 SHEIN 授权：
# 访问 https://admin-panel-4ylw.vercel.app/admin/shein-auth 完成授权
# 授权成功后将获取的密钥填入上述环境变量
#
# 注意：
# - 本项目不需要外部数据库，使用本地 SQLite 存储配置
# - Vercel 无服务器环境的文件系统是临时的，重启后数据会丢失
# - 如需持久化重要数据，建议使用 Vercel KV 或其他外部存储
#

