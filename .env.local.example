# ========================================
# 数据库配置
# ========================================
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./dev.db

# ========================================
# SHEIN 测试环境配置
# ========================================

# SHEIN 应用配置（从 SHEIN 开发者门户获取）
# 步骤：登录开发者门户 -> 应用管理 -> 查看应用详情
SHEIN_APP_ID=165CD4A72F002A7089ABF6C17B979
SHEIN_APP_SECRET_KEY=2DC257D4F14549DAB3B1AE93AE352AE0

# SHEIN API 调用域名（测试环境）
SHEIN_API_BASE_URL=https://openapi-test01.sheincorp.cn

# SHEIN 店铺授权密钥（通过授权流程自动获取，暂时留空）
# 访问 http://localhost:3000/admin/shein-auth 进行授权
SHEIN_OPEN_KEY_ID=
SHEIN_SECRET_KEY=

# ========================================
# 切换到正式环境时的配置（注释掉测试环境，取消以下注释）
# ========================================
# SHEIN_APP_ID=your_production_app_id_here
# SHEIN_APP_SECRET_KEY=your_production_app_secret_key_here
# SHEIN_API_BASE_URL=https://openapi.sheincorp.com
# SHEIN_OPEN_KEY_ID=
# SHEIN_SECRET_KEY=
